# DataGuard Environment Variables
# Copy this file to .env.local and fill in your API keys
# cp .env.example .env.local

# ============================================
# HAVE I BEEN PWNED - Password Breach Check
# Get free API key: https://haveibeenpwned.com/API/Key
# Required for breach check on passwords
# ============================================
HIBP_API_KEY=

# ============================================
# VIRUSTOTAL - URL, Domain & IP Analysis
# Free tier: 500 lookups/day, 4/min
# Sign up: https://www.virustotal.com/gui/join-us
# ============================================
VIRUSTOTAL_API_KEY=

# ============================================
# ABUSEIPDB - IP Threat Intelligence
# Free tier: 1,000 lookups/day
# Sign up: https://www.abuseipdb.com/api
# ============================================
ABUSEIPDB_API_KEY=

# ============================================
# ALIENVAULT OTX - Threat Intelligence
# Free tier: 10,000 lookups/day
# Sign up: https://otx.alienvault.com/api
# ============================================
ALIENVAULT_OTX_KEY=

# ============================================
# WHOISXML API - Domain WHOIS & RDAP
# Get free API key: https://www.whoisxmlapi.com/
# ============================================
WHOISXML_API_KEY=

# ============================================
# GOOGLE SAFE BROWSING / WEB RISK
# Free tier: 10,000 lookups/day
# Console: https://console.cloud.google.com/
# Enable: Safe Browsing API or Web Risk API
# ============================================
GOOGLE_SAFE_BROWSING_KEY=
GOOGLE_WEB_RISK_API_KEY=

# ============================================
# URLSCAN.IO - URL Scanning & Analysis
# Free tier: 100 scans/day
# Sign up: https://urlscan.io/user/api/
# ============================================
URLSCAN_API_KEY=
URLSCAN_API_KEY_SECONDARY=

# ============================================
# IPINFO - IP Geolocation & ASN
# Free tier: 50,000 lookups/month
# Sign up: https://ipinfo.io/account
# ============================================
IPINFO_TOKEN=

# ============================================
# SHODAN - Network Attack Surface Mapping
# Free tier: 1 query/minute, 10,000 credits
# Sign up: https://account.shodan.io/
# ============================================
SHODAN_API_KEY=

# ============================================
# CENSYS - Internet Attack Surface Data
# Free tier: 10,000 queries/month
# Sign up: https://search.censys.io/account/api
# ============================================
CENSYS_API_TOKEN=

# ============================================
# ETHERSCAN - Ethereum Blockchain Data
# Free API key: https://etherscan.io/apis
# ============================================
ETHERSCAN_API_KEY=
