# DataGuard Environment Configuration Template
# Copy this file to .env.local and fill in your API keys

# AbuseIPDB API v2 Key (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# VirusTotal API v3 Key (https://www.virustotal.com/gui/user/<username>/apikey)
VIRUSTOTAL_API_KEY=

# Etherscan API v2 Key (https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=

# AlienVault OTX Key (https://otx.alienvault.com/settings)
ALIENVAULT_OTX_KEY=
